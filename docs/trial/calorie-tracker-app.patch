diff --git a/src/CalorieTracker.UI.ScreenStories/wwwroot/css/app-tokens.css b/src/CalorieTracker.UI.ScreenStories/wwwroot/css/app-tokens.css
new file mode 100644
index 0000000..7b1b745
--- /dev/null
+++ b/src/CalorieTracker.UI.ScreenStories/wwwroot/css/app-tokens.css
@@ -0,0 +1,45 @@
+/* Tokens only this app uses; the shared ones come from Shields.UI. */
+:root {
+    /* The filled icon button's chip and the icon on it. Its own token, not --color-selected or --color-secondary,
+       so retuning those does not change the chip. */
+    --color-chip: light-dark(#6a9594, #587a7a);
+    --color-on-chip: light-dark(#141819, #ffffff);
+    /* The usual-food + in the Add sheet: a lighter, muted circle than the chip, with a plus that stays readable on it. */
+    --color-chip-soft: light-dark(#92b6b5, #466161);
+    --color-on-chip-soft: light-dark(#243d3d, #e4ecec);
+    /* The calorie ring's track: 3:1 against the card, and the accent and error arcs keep 3:1 against it (accent is a darkened teal; error is darker in light and lighter in dark for that). */
+    --color-ring-track: light-dark(#829493, #667476);
+    /* The energy share bar's segments. */
+    --color-protein: light-dark(#2f7f86, #7fc4cc);
+    --color-carbs: light-dark(#a35c00, #e0a860);
+    --color-fat: light-dark(#7a5aa6, #c3a8e8);
+    /* The trend chart's target band: a faint accent wash behind the bars, so the bars keep their own colours on top of it. */
+    --color-target-band: light-dark(rgb(41 73 76 / 0.14), rgb(172 213 210 / 0.18));
+    --font-size-xs: 0.75rem;
+    --font-size-input: 1.25rem;
+    --letter-spacing-label: 0.08em;
+    --touch-target-compact: 40px;
+    --border-width-error: 2px;
+    --opacity-thin: 0.55;
+    --pull-refresh-threshold: 64px;
+    --pull-refresh-return-duration: 200ms;
+    --snackbar-enter-duration: 150ms;
+    --ring-size: 8.75rem;
+    --ring-width: 0.875rem;
+    --ring-size-compact: 6rem;
+    --ring-width-compact: 0.625rem;
+    --share-bar-height: 0.75rem;
+    --chart-dash: 6px 4px;
+    --radio-size: 1.5rem;
+    --radio-dot-size: 0.75rem;
+    --nav-indicator-width: 4rem;
+    --nav-indicator-height: 2rem;
+    --add-button-size: 3.5rem;
+    --add-button-lift: 1.25rem;
+    --sheet-enter-duration: 200ms;
+    --sheet-max-width: 32rem;
+    --sheet-handle-width: 3rem;
+    --sheet-handle-height: 0.375rem;
+    --sheet-tile-min-height: 6.5rem;
+    --sheet-tile-icon-size: 2rem;
+}
