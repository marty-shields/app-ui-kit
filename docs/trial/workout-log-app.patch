+using Microsoft.Extensions.DependencyInjection;
+
+namespace WorkoutLog.UI.ScreenStories;
+
+public static class WorkoutLogStories
+{
+    /// <summary>Registers what Workout Log's screen stories need. The trial story renders without Core's services; the full split moves the sample services here.</summary>
+    public static IServiceCollection AddWorkoutLogStories(this IServiceCollection services) => services.AddUi();
+}
