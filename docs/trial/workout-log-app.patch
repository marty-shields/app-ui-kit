+@using WorkoutLog.UI.ScreenStories.Screens
+@attribute [Stories("Workout Log/Screens/This week")]
+
+<Stories TComponent="ThisWeekView" Layout="typeof(WorkoutLogLayout)">
+
+    <Story Name="Mid-week">
+        <Template>
+            <ThisWeekView Monday="SampleThisWeek.Monday" Today="SampleThisWeek.Wednesday" Trained="SampleThisWeek.TrainedDays" Streak="23"
+                          ThisWeek="SampleThisWeek.ThisWeek" LastWeekToDate="SampleThisWeek.LastWeekToDate"
+                          Workouts="SampleThisWeek.Workouts" Records="SampleThisWeek.Records" Muscles="SampleThisWeek.Muscles"
+                          OnSettings="() => { }" OnNew="() => { }" OnNavigate="(MainTab _) => { }"
+                          OnOpenWorkout="(int _) => { }" OnOpenRecord="(int _) => { }" />
+        </Template>
+    </Story>
+
+</Stories>
