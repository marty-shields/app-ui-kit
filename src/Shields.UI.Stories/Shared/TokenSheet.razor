@using Microsoft.JSInterop
@* Shows every token in the kit's tokens.css, plus any extra tokens the app passes: colours in light and dark, then type, spacing, radius and sizes. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="sheet" @ref="sheet">
    <h2 class="heading">Colour</h2>
    <table class="colours">
        <thead>
            <tr>
                <th>Token</th>
                <th>Light</th>
                <th>Dark</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var name in Colours.Concat(ExtraColours))
            {
                <tr data-token="@name">
                    <td><code>@name</code></td>
                    @foreach (var theme in Themes)
                    {
                        <td data-theme="@theme">
                            <span class="swatch" style="background: var(@name)"></span>
                            <code class="value">@Value($"{name} {theme}")</code>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <h2 class="heading">Type</h2>
    <ul class="list">
        @foreach (var name in Type)
        {
            <li class="item" data-token="@name">
                <code>@name</code>
                <code class="value">@Value(name)</code>
                <span class="sample" style="@SampleStyle(name)">Squat 3 × 5 @@ 100 kg</span>
            </li>
        }
    </ul>

    <h2 class="heading">Spacing</h2>
    <ul class="list">
        @foreach (var name in Spacing)
        {
            <li class="item" data-token="@name">
                <code>@name</code>
                <code class="value">@Value(name)</code>
                <span class="bar" style="width: var(@name)"></span>
            </li>
        }
    </ul>

    <h2 class="heading">Radius</h2>
    <ul class="list">
        @foreach (var name in Radius)
        {
            <li class="item" data-token="@name">
                <code>@name</code>
                <code class="value">@Value(name)</code>
                <span class="corner" style="border-radius: var(@name)"></span>
            </li>
        }
    </ul>

    <h2 class="heading">Sizes</h2>
    <ul class="list">
        @foreach (var name in Sizes.Concat(ExtraSizes))
        {
            <li class="item" data-token="@name">
                <code>@name</code>
                <code class="value">@Value(name)</code>
            </li>
        }
    </ul>
</div>

@code {
    private static readonly string[] Themes = ["light", "dark"];

    private static readonly string[] Colours =
    [
        "--color-bg", "--color-surface", "--color-border", "--color-border-strong",
        "--color-text", "--color-text-muted",
        "--color-bar", "--color-on-bar", "--color-on-bar-muted",
        "--color-primary", "--color-on-primary", "--color-secondary", "--color-on-secondary",
        "--color-selected", "--color-chip", "--color-on-chip", "--color-chip-soft", "--color-on-chip-soft",
        "--color-accent", "--color-focus",
        "--color-danger", "--color-on-danger", "--color-error", "--color-success",
        "--color-inverse-surface", "--color-on-inverse-surface", "--color-inverse-primary", "--color-scrim",
        "--state-pressed",
    ];

    private static readonly string[] Type =
    [
        "--font-family",
        "--font-size-sm", "--font-size-md", "--font-size-lg", "--font-size-xl", "--font-size-xxl", "--font-size-input",
        "--font-weight-regular", "--font-weight-bold",
        "--line-height", "--line-height-tight", "--letter-spacing-label",
    ];

    private static readonly string[] Spacing = ["--space-1", "--space-2", "--space-3", "--space-4", "--space-6", "--space-8"];

    private static readonly string[] Radius = ["--radius-sm", "--radius-md", "--radius-lg", "--radius-round"];

    private static readonly string[] Sizes =
    [
        "--touch-target", "--touch-target-compact", "--border-width", "--border-width-error", "--focus-width", "--focus-offset",
        "--opacity-disabled", "--dialog-max-width",
        "--spinner-size", "--spinner-width", "--spinner-size-small", "--spinner-width-small", "--spinner-duration", "--snackbar-enter-duration",
        "--pull-refresh-threshold", "--pull-refresh-return-duration", "--shadow-raised",
        "--radio-size", "--radio-dot-size", "--nav-indicator-width", "--nav-indicator-height",
        "--add-button-size", "--add-button-lift", "--legend-swatch-size",
    ];

    /// <summary>Colour tokens the app declares itself, shown in light and dark after the kit's.</summary>
    [Parameter]
    public IReadOnlyList<string> ExtraColours { get; set; } = [];

    /// <summary>Other tokens the app declares itself (sizes, durations, shadows), shown after the kit's sizes.</summary>
    [Parameter]
    public IReadOnlyList<string> ExtraSizes { get; set; } = [];

    private ElementReference sheet;
    private IJSObjectReference? module;
    private Dictionary<string, string> values = [];

    #pragma warning disable BL0016 // A story whose script fails should fail loudly in the browser, not be caught.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Shields.UI.Stories/Shared/TokenSheet.razor.js");
        values = await module.InvokeAsync<Dictionary<string, string>>("read", sheet);
        StateHasChanged();
    }
    #pragma warning restore BL0016

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private string? Value(string key) => values.GetValueOrDefault(key);

    private static string SampleStyle(string name) => name switch
    {
        "--font-family" => $"font-family: var({name})",
        _ when name.StartsWith("--font-size") => $"font-size: var({name})",
        _ when name.StartsWith("--font-weight") => $"font-weight: var({name})",
        _ => $"line-height: var({name})",
    };
}
