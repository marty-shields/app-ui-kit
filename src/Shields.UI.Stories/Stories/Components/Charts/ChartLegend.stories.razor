@attribute [Stories("Components/Charts/ChartLegend")]

<Stories TComponent="ChartLegend" Layout="typeof(ThemeLayout)">

    <Story Name="Plain dots">
        <Template>
            <ChartLegend Items="Plain" TestId="legend" />
        </Template>
    </Story>

    <Story Name="Dot with a marker">
        <Template>
            <ChartLegend Items="WithMarker" TestId="legend" />
        </Template>
    </Story>

    <Story Name="Long labels">
        <Template>
            <ChartLegend Items="Long" TestId="legend" />
        </Template>
    </Story>

    <Story Name="Light">
        <Template>
            <div class="themed" data-theme="light">
                <ChartLegend Items="WithMarker" />
            </div>
        </Template>
    </Story>

    <Story Name="Dark">
        <Template>
            <div class="themed" data-theme="dark">
                <ChartLegend Items="WithMarker" />
            </div>
        </Template>
    </Story>

</Stories>

@code {
    private static readonly IReadOnlyList<LegendItem> Plain =
    [
        new(LegendSwatch.Chip, "Under"),
        new(LegendSwatch.Accent, "On target"),
        new(LegendSwatch.Outline, "Not logged"),
        new(LegendSwatch.Line, "Target"),
        new(LegendSwatch.Band, "Target range"),
    ];

    private static readonly IReadOnlyList<LegendItem> Long =
    [
        new(LegendSwatch.Chip, "Under the daily calorie target by more than one hundred kcal"),
        new(LegendSwatch.Accent, "Within the daily calorie target range"),
        new(LegendSwatch.Error, "Over the daily calorie target by any amount at all", "▲"),
    ];

    private static readonly IReadOnlyList<LegendItem> WithMarker =
    [
        new(LegendSwatch.Chip, "Under"),
        new(LegendSwatch.Accent, "On target"),
        new(LegendSwatch.Error, "Over", "▲"),
    ];
}
