@using System.Globalization
@attribute [Stories("Components/Charts/TrendBarChart")]

<Stories TComponent="TrendBarChart" Layout="typeof(ThemeLayout)">

    <Story Name="Week against target">
        <Template>
            <div class="card">
                <TrendBarChart Bars="Week" Target="2000" Unit="pts" OnSelect="_ => { }" TestId="chart" />
                <ChartLegend Items="Legend" />
            </div>
        </Template>
    </Story>

    <Story Name="Some bars not selectable">
        <Template>
            <div class="card">
                <TrendBarChart Bars="WeekPartlySelectable" Target="2000" Unit="pts" OnSelect="_ => { }" TestId="chart" />
            </div>
        </Template>
    </Story>

    <Story Name="Year by month">
        <Template>
            <div class="card">
                <TrendBarChart Bars="Year" Target="2000" DateFormat="MMMM yyyy" Label="Average by month" OnSelect="_ => { }" TestId="chart" />
            </div>
        </Template>
    </Story>

    <Story Name="Without the over marker">
        <Template>
            <div class="card">
                <TrendBarChart Bars="Week" Target="2000" Unit="pts" ShowOverMarker="false" TestId="chart" />
                <ChartLegend Items="UnmarkedLegend" />
            </div>
        </Template>
    </Story>

    <Story Name="All over">
        <Template>
            <div class="card">
                <TrendBarChart Bars="AllOver" Target="2000" OnSelect="_ => { }" TestId="chart" />
            </div>
        </Template>
    </Story>

    <Story Name="Empty">
        <Template>
            <div class="card">
                <TrendBarChart Bars="Empty" Target="2000" TestId="chart" />
            </div>
        </Template>
    </Story>

    <Story Name="Long labels">
        <Template>
            <div class="card">
                <TrendBarChart Bars="LongLabels" Target="2000" OnSelect="_ => { }" TestId="chart" />
            </div>
        </Template>
    </Story>

    <Story Name="No target">
        <Template>
            <div class="card">
                <TrendBarChart Bars="Week" OnSelect="_ => { }" TestId="chart" />
            </div>
        </Template>
    </Story>

    <Story Name="Light">
        <Template>
            <div class="themed" data-theme="light">
                <div class="card">
                    <TrendBarChart Bars="Week" Target="2000" />
                    <ChartLegend Items="Legend" />
                </div>
            </div>
        </Template>
    </Story>

    <Story Name="Fixed max">
        <Template>
            <div class="card">
                <TrendBarChart Bars="Week" Target="2000" Max="3000" Unit="pts" Label="Points per day, scale to 3,000" TestId="chart" />
            </div>
        </Template>
    </Story>

    <Story Name="Fixed max, past and current">
        <Template>
            <div class="card">
                <TrendBarChart Bars="PastWeek" Style="TrendBarStyle.PastAndCurrent" Max="120" Unit="min" Label="Minutes per day, scale to 120" TestId="chart" />
            </div>
        </Template>
    </Story>

    <Story Name="Past and current">
        <Template>
            <div class="card">
                <TrendBarChart Bars="PastWeek" Style="TrendBarStyle.PastAndCurrent" Unit="min" Label="Minutes per day" TestId="chart" />
                <ChartLegend Items="PastLegend" />
            </div>
        </Template>
    </Story>

    <Story Name="Past and current, with the period before">
        <Template>
            <div class="card">
                <TrendBarChart Bars="PairedWeek" Style="TrendBarStyle.PastAndCurrent" EarlierLabel="last week" Unit="min" Label="Minutes per day" TestId="chart" />
                <ChartLegend Items="PairedLegend" />
            </div>
        </Template>
    </Story>

    <Story Name="Past and current, dark">
        <Template>
            <div class="themed" data-theme="dark">
                <div class="card">
                    <TrendBarChart Bars="PairedWeek" Style="TrendBarStyle.PastAndCurrent" Unit="min" />
                    <ChartLegend Items="PairedLegend" />
                </div>
            </div>
        </Template>
    </Story>

    <Story Name="Dark">
        <Template>
            <div class="themed" data-theme="dark">
                <div class="card">
                    <TrendBarChart Bars="Week" Target="2000" />
                    <ChartLegend Items="Legend" />
                </div>
            </div>
        </Template>
    </Story>

</Stories>

@code {
    private static readonly DateOnly Monday = new(2026, 11, 9);

    private static readonly IReadOnlyList<TrendBarPoint> WeekPartlySelectable =
    [
        new(Monday, "Mon", 1800),
        new(Monday.AddDays(1), "Tue", 2100),
        new(Monday.AddDays(2), "Wed", 2000),
        new(Monday.AddDays(3), "Thu", 900, Selectable: false),
        new(Monday.AddDays(4), "Fri", 1500, Selectable: false),
    ];

    private static readonly IReadOnlyList<LegendItem> Legend =
    [
        new(LegendSwatch.Chip, "Under"),
        new(LegendSwatch.Accent, "On target"),
        new(LegendSwatch.Error, "Over", "▲"),
        new(LegendSwatch.Line, "Target"),
        new(LegendSwatch.Band, "Target range"),
    ];

    private static readonly IReadOnlyList<LegendItem> UnmarkedLegend =
    [
        new(LegendSwatch.Chip, "Under"),
        new(LegendSwatch.Accent, "On target"),
        new(LegendSwatch.Error, "Over"),
        new(LegendSwatch.Line, "Target"),
        new(LegendSwatch.Band, "Target range"),
    ];

    private static readonly IReadOnlyList<LegendItem> PastLegend = [new(LegendSwatch.Accent, "Today"), new(LegendSwatch.Past, "Earlier days")];

    private static readonly IReadOnlyList<LegendItem> PairedLegend = [new(LegendSwatch.Accent, "This week"), new(LegendSwatch.Past, "Last week")];

    private static TrendBarPoint Day(int day, double? value, string? label = null) =>
        new(Monday.AddDays(day), label ?? Monday.AddDays(day).ToString("ddd", CultureInfo.InvariantCulture), value);

    private static readonly IReadOnlyList<TrendBarPoint> Week =
        [Day(0, 1500), Day(1, 2000), Day(2, 2600), Day(3, null), Day(4, 1900), Day(5, 2150), Day(6, 900)];

    private static readonly IReadOnlyList<TrendBarPoint> AllOver =
        [.. Enumerable.Range(0, 7).Select(i => Day(i, 2500 + i * 100))];

    private static readonly IReadOnlyList<TrendBarPoint> Empty = [.. Enumerable.Range(0, 7).Select(i => Day(i, null))];

    private static readonly IReadOnlyList<TrendBarPoint> LongLabels =
        [.. Enumerable.Range(0, 7).Select(i => Day(i, 1800 + i * 50, "Monday afternoon"))];

    private static readonly IReadOnlyList<TrendBarPoint> Year =
        [.. Enumerable.Range(1, 12).Select(m => new TrendBarPoint(new DateOnly(2026, m, 1), new DateOnly(2026, m, 1).ToString("MMM", CultureInfo.InvariantCulture), m is 4 or 8 ? null : 1400 + m * 90))];

    private static readonly IReadOnlyList<TrendBarPoint> PastWeek =
        [Day(0, 40) with { Labelled = true }, Day(1, 55) with { Labelled = true }, Day(2, null), Day(3, 35) with { Labelled = true }, Day(4, 62) with { Labelled = true, Current = true }, Day(5, null), Day(6, null)];

    private static readonly IReadOnlyList<TrendBarPoint> PairedWeek =
        [Day(0, 40) with { Earlier = 30 }, Day(1, 55) with { Earlier = 60 }, Day(2, null) with { Earlier = 45 }, Day(3, 35, "Thu") with { Earlier = null }, Day(4, 62) with { Current = true, Labelled = true, Earlier = 50 }, Day(5, null), Day(6, null)];
}
