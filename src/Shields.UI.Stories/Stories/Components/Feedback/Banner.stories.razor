@attribute [Stories("Components/Feedback/Banner")]

<Stories TComponent="Banner" Layout="typeof(ThemeLayout)">

    <Story Name="Selected">
        <Template>
            <Banner TestId="banner">Adding to Lunch</Banner>
        </Template>
    </Story>

    <Story Name="WithActions">
        <Template>
            <Banner TestId="banner">
                <ChildContent>Workout in progress</ChildContent>
                <Actions>
                    <AppButton TestId="banner-resume">Resume</AppButton>
                    <AppButton Variant="ButtonVariant.Secondary" TestId="banner-discard">Discard</AppButton>
                </Actions>
            </Banner>
        </Template>
    </Story>

    <Story Name="Light">
        <Template>
            <div class="themed" data-theme="light">
                <Banner>Adding to Lunch</Banner>
            </div>
        </Template>
    </Story>

    <Story Name="DarkWithActions">
        <Template>
            <div class="themed" data-theme="dark">
                <Banner>
                    <ChildContent>Workout in progress</ChildContent>
                    <Actions>
                        <AppButton>Resume</AppButton>
                        <AppButton Variant="ButtonVariant.Secondary">Discard</AppButton>
                    </Actions>
                </Banner>
            </div>
        </Template>
    </Story>

    <Story Name="Dark">
        <Template>
            <div class="themed" data-theme="dark">
                <Banner>Adding to Lunch</Banner>
            </div>
        </Template>
    </Story>

</Stories>
