    <Story Name="Long page, dark">
        <Template>
            <div class="themed" data-theme="dark">
                <AppScreen Title="Today" NavItems="Tabs" Current="Tabs[0]" AddLabel="Add" AddIcon="IconName.Plus" OnNavigate="(BottomNavItem _) => { }" OnAdd="() => { }">
                    @for (var row = 1; row <= 20; row++)
                    {
                        <p>Row @row</p>
                    }
