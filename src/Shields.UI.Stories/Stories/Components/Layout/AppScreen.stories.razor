                    <ChildContent>
                        <p>Scrolling content.</p>
                    </ChildContent>
                    <Status>
                        <Snackbar Message="Entry deleted" ActionLabel="Undo" OnAction="@(() => { })" Duration="Timeout.InfiniteTimeSpan" />
                    </Status>
                </AppScreen>
            </div>
        </Template>
    </Story>

    <Story Name="Long page, light">
        <Template>
            <div class="themed" data-theme="light">
