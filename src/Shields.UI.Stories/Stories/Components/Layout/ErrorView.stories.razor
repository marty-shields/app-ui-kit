@attribute [Stories("Components/Layout/ErrorView")]

<Stories TComponent="ErrorView" Layout="typeof(PhoneLayout)">

    <Story Name="Default">
        <Template>
            <div class="themed">
                <ErrorView Title="My App" />
            </div>
        </Template>
    </Story>

    <Story Name="Light">
        <Template>
            <div class="themed" data-theme="light">
                <ErrorView Title="My App" />
            </div>
        </Template>
    </Story>

    <Story Name="Dark">
        <Template>
            <div class="themed" data-theme="dark">
                <ErrorView Title="My App" />
            </div>
        </Template>
    </Story>

</Stories>
