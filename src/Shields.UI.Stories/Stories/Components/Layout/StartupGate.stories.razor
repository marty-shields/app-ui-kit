@attribute [Stories("Components/Layout/StartupGate")]

<Stories TComponent="StartupGate" Layout="typeof(PhoneLayout)">

    <Story Name="Loading">
        <Template>
            <div class="themed">
                <StartupGate Title="My App" FailedMessage="Couldn't open the database" Initialize="() => new TaskCompletionSource().Task">
                    <p>App content.</p>
                </StartupGate>
            </div>
        </Template>
    </Story>

    <Story Name="Load failed">
        <Template>
            <div class="themed">
                <StartupGate Title="My App" FailedMessage="Couldn't open the database" Initialize="() => Task.FromException(new InvalidOperationException())">
                    <p>App content.</p>
                </StartupGate>
            </div>
        </Template>
    </Story>

    <Story Name="Load failed, no retry">
        <Template>
            <div class="themed">
                <StartupGate Title="My App" FailedMessage="Couldn't open the database" Retryable="false" Initialize="() => Task.FromException(new InvalidOperationException())">
                    <p>App content.</p>
                </StartupGate>
            </div>
        </Template>
    </Story>

    <Story Name="Ready">
        <Template>
            <div class="themed">
                <StartupGate FailedMessage="Couldn't open the database" Initialize="() => Task.CompletedTask">
                    <p>App content.</p>
                </StartupGate>
            </div>
        </Template>
    </Story>

</Stories>
