@attribute [Stories("Components/Lists/SectionHeader")]

<Stories TComponent="SectionHeader" Layout="typeof(ThemeLayout)">

    <Story Name="Plain heading">
        <Template>
            <SectionHeader Title="Morning" Total="3 items" TestId="head" />
        </Template>
    </Story>

    <Story Name="Badge">
        <Template>
            <SectionHeader Title="Morning" Badge="Now" Total="3 items" TestId="head" />
        </Template>
    </Story>

    <Story Name="Collapsed">
        <Template>
            <SectionHeader Title="Morning" Total="3 items" Expanded="false" ExpandedChanged="_ => { }" ControlsId="panel" TestId="head" />
        </Template>
    </Story>

    <Story Name="Expanded">
        <Template>
            <SectionHeader Title="Morning" Badge="Now" Total="3 items" Expanded="true" ExpandedChanged="_ => { }" ControlsId="panel" TestId="head" />
        </Template>
    </Story>

    <Story Name="Hint">
        <Template>
            <SectionHeader Title="Lunch" Hint="from 11:00" Total="521 kcal" TestId="head" />
        </Template>
    </Story>

    <Story Name="Collapsible with hint">
        <Template>
            <SectionHeader Title="Lunch" Badge="Now" Hint="from 11:00" Total="521 kcal" Expanded="true" ExpandedChanged="_ => { }" ControlsId="panel" TestId="head" />
        </Template>
    </Story>

    <Story Name="Long title with hint">
        <Template>
            <SectionHeader Title="An especially long section title that has to wrap" Badge="Now" Hint="from 11:00" Total="1,234 kcal" Expanded="true" ExpandedChanged="_ => { }" TestId="head" />
        </Template>
    </Story>

    <Story Name="Long title">
        <Template>
            <SectionHeader Title="An especially long section title that has to wrap" Badge="Now" Total="1,234 items" Expanded="true" ExpandedChanged="_ => { }" TestId="head" />
        </Template>
    </Story>

    <Story Name="Sticky with a count">
        <Template>
            <section>
                <SectionHeader Title="November 2026" Total="4 workouts" Sticky />
                <ListRow Text="Tue 20 Oct" Detail="Back Squat" />
            </section>
        </Template>
    </Story>

    <Story Name="Light">
        <Template>
            <div class="themed" data-theme="light">
                <SectionHeader Title="Morning" Badge="Now" Total="3 items" Expanded="true" ExpandedChanged="_ => { }" />
            </div>
        </Template>
    </Story>

    <Story Name="Dark">
        <Template>
            <div class="themed" data-theme="dark">
                <SectionHeader Title="Morning" Badge="Now" Total="3 items" Expanded="false" ExpandedChanged="_ => { }" />
            </div>
        </Template>
    </Story>

</Stories>
