@attribute [Stories("Components/Overlays/SheetAction")]

<Stories TComponent="SheetAction" Layout="typeof(ThemeLayout)">

    <Story Name="Pair">
        <Template>
            @foreach (var theme in Themes)
            {
                <div class="themed" data-theme="@theme">
                    <SheetAction Icon="IconName.Search" Label="Search" TestId="@($"search-{theme}")" />
                    <SheetAction Icon="IconName.Scan" Label="Scan" TestId="@($"scan-{theme}")" />
                </div>
            }
        </Template>
    </Story>

    <Story Name="Long label">
        <Template>
            @foreach (var theme in Themes)
            {
                <div class="themed single" data-theme="@theme">
                    <SheetAction Icon="IconName.Calendar" Label="Choose another day to see" TestId="@($"long-{theme}")" />
                </div>
            }
        </Template>
    </Story>

</Stories>

@code {
    private static readonly string[] Themes = ["light", "dark"];
}
