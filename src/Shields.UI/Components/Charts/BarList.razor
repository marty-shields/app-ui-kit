@using System.Globalization
@using System.Text
@if (Items.Count == 0)
{
    <p class="none" data-wrap-ok data-testid="@Id("empty")">@EmptyText</p>
}
else if (AllZeroText is not null && Items.All(i => i.Value == 0))
{
    <p class="none" data-wrap-ok data-testid="@Id("all-zero")">@AllZeroText</p>
}
else
{
    var full = FullBar();
    <ul class="list @(Inline ? "inline" : null) @(OnSelect.HasDelegate ? "selectable" : null) @LabelClass @ValueClass" aria-label="@Label" data-testid="@TestId">
        @for (var i = 0; i < Items.Count; i++)
        {
            var item = Items[i];
            var index = i;
            <li class="item" data-testid="@Id($"row-{Key(i)}")">
                @if (OnSelect.HasDelegate && item.Selectable)
                {
                    <button type="button" class="tap row" data-testid="@Id($"select-{Key(i)}")" @onclick="() => OnSelect.InvokeAsync(index)">@Cells(item, index, full)</button>
                }
                else
                {
                    <div class="row">@Cells(item, index, full)</div>
                }
            </li>
        }
    </ul>
}

@code {
    /// <summary>The rows, in the order shown.</summary>
    [Parameter]
    public IReadOnlyList<BarListItem> Items { get; set; } = [];

    /// <summary>The value that fills a whole bar. Null, zero, negative or non-finite means the largest value in the list.</summary>
    [Parameter]
    public double? Max { get; set; }

    /// <summary>The accessible name of the list.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>Shown instead of the list when it has no rows.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "Nothing yet";

    /// <summary>Shown instead of the bars when there are rows and every value is zero. Null shows the rows with empty bars. Looks like <see cref="EmptyText"/>.</summary>
    [Parameter]
    public string? AllZeroText { get; set; }

    /// <summary>Puts each row's label, bar and value on one line, with the label and value in columns of fixed width, instead of the bar under the label and value.</summary>
    [Parameter]
    public bool Inline { get; set; }

    /// <summary>The width of the label column. Only applies to an <see cref="Inline"/> list.</summary>
    [Parameter]
    public BarListLabelWidth LabelWidth { get; set; }

    /// <summary>The width of the value column. Only applies to an <see cref="Inline"/> list.</summary>
    [Parameter]
    public BarListValueWidth ValueWidth { get; set; }

    /// <summary>Text read after each value by a screen reader and not shown, such as "sessions". Null for none.</summary>
    [Parameter]
    public string? Unit { get; set; }

    /// <summary>Raised with the row's position when a row is tapped. Without a handler no row is tappable, and the rows that have <see cref="BarListItem.Selectable"/> false never are.</summary>
    [Parameter]
    public EventCallback<int> OnSelect { get; set; }

    /// <summary>What the per-row test ids carry: the row's position (the default) or its label slug, which stays the same when rows are added or reordered.</summary>
    [Parameter]
    public BarListTestIdBy TestIdBy { get; set; }

    /// <summary>
    /// Value of the data-testid attribute, and the prefix of <c>-row-{n}</c>, <c>-label-{n}</c>, <c>-value-{n}</c> and <c>-bar-{n}</c>, and <c>-select-{n}</c> on the button of a tappable row,
    /// where <c>{n}</c> follows <see cref="TestIdBy"/>; <c>-empty</c> when there are no rows and <c>-all-zero</c> when <see cref="AllZeroText"/> is shown. None are rendered when unset.
    /// </summary>
    [Parameter]
    public string? TestId { get; set; }

    private string[] slugs = [];

    protected override void OnParametersSet() => slugs = TestIdBy == BarListTestIdBy.Slug ? Slugs(Items) : [];

    private string Key(int index) => TestIdBy == BarListTestIdBy.Slug ? slugs[index] : index.ToString(CultureInfo.InvariantCulture);

    private static string[] Slugs(IReadOnlyList<BarListItem> items)
    {
        var taken = new HashSet<string>();
        var slugs = new string[items.Count];
        for (var i = 0; i < items.Count; i++)
        {
            var slug = Slug(items[i].Label);
            var unique = slug;
            for (var n = 2; !taken.Add(unique); n++)
            {
                unique = $"{slug}-{n}";
            }

            slugs[i] = unique;
        }

        return slugs;
    }

    /// <summary>Lowercase letters and digits, each run of other characters as one dash, none at either end. "item" when nothing is left.</summary>
    private static string Slug(string label)
    {
        var slug = new StringBuilder();
        foreach (var c in label.ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(c))
            {
                slug.Append(c);
            }
            else if (slug.Length > 0 && slug[^1] != '-')
            {
                slug.Append('-');
            }
        }

        return slug.ToString().TrimEnd('-') is { Length: > 0 } text ? text : "item";
    }

    private RenderFragment Cells(BarListItem item, int index, double full) =>
        @<text>
            <span class="name" data-testid="@Id($"label-{Key(index)}")">@item.Label</span>
            <span class="value" data-testid="@Id($"value-{Key(index)}")">@(item.ValueText ?? Number(item.Value))@if (Unit is not null) {<span class="visually-hidden">@($" {Unit}")</span>}</span>
            <span class="track" aria-hidden="true"><span class="fill" style="--fill: @Share(item, full)" data-testid="@Id($"bar-{Key(index)}")"></span></span>
        </text>;

    private string? LabelClass => LabelWidth switch { BarListLabelWidth.Wide => "label-wide", BarListLabelWidth.Narrow => "label-narrow", _ => null };

    private string? ValueClass => ValueWidth == BarListValueWidth.Narrow ? "value-narrow" : null;

    private static double Counted(double value) => double.IsFinite(value) ? Math.Max(value, 0) : 0;

    private double FullBar() => Max is > 0 && double.IsFinite(Max.Value) ? Max.Value : Items.Max(i => Counted(i.Value));

    /// <summary>Share of the track the bar fills, 0 to 1.</summary>
    private static string Share(BarListItem item, double full)
    {
        return (full > 0 ? Math.Clamp(Counted(item.Value) / full, 0, 1) : 0).ToString("0.####", CultureInfo.InvariantCulture);
    }

    private string? Id(string part) => TestId is null ? null : $"{TestId}-{part}";

    private static string Number(double value) => (Math.Round(double.IsFinite(value) ? value : 0, MidpointRounding.AwayFromZero) + 0.0).ToString("N0", CultureInfo.InvariantCulture);
}
