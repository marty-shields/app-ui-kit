@using System.Globalization
<div class="ring @(IsOver ? "over" : null) @(Compact ? "compact" : null)" role="img" aria-label="@Description" data-testid="@TestId" style="--fill: @Fill">
    <span class="arc" aria-hidden="true"></span>
    <span class="centre" aria-hidden="true">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            <span class="value @Width" data-testid="@Id("value")">@Text</span>
        }
        @if (Unit is not null)
        {
            <span class="caption" data-testid="@Id("caption")">@Unit</span>
        }
    </span>
</div>

@code {
    /// <summary>How far along it is, in the same unit as <see cref="Max"/>. Negative and non-finite values count as zero; fractions are rounded for display.</summary>
    [Parameter]
    public double Value { get; set; }

    /// <summary>The value that fills the ring. Zero or negative means no maximum: the ring is full once <see cref="Value"/> is above zero, and never over.</summary>
    [Parameter]
    public double Max { get; set; }

    /// <summary>The smaller ring (<c>--ring-size-compact</c>) that sits beside other figures in a card.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>A short line under the centre text, such as its unit. <see cref="FigureUnit"/> takes its place when set.</summary>
    [Parameter]
    public string? Caption { get; set; }

    /// <summary>The big centre text in place of the value, for a figure other than <see cref="Value"/>, such as what is left. Styled like the value: smaller when long, <c>--color-ring-arc-over</c> when over. Ignored when <see cref="ChildContent"/> is set. Hidden from screen readers like the rest of the centre, so set <see cref="AriaLabel"/> to describe the figure when it differs from the value.</summary>
    [Parameter]
    public string? Figure { get; set; }

    /// <summary>A smaller line under the centre text, such as "kcal left", in place of <see cref="Caption"/>; it applies to the default value text when there is no <see cref="Figure"/>. Ignored when <see cref="ChildContent"/> is set, which leaves <see cref="Caption"/> as it is. The default accessible name does not include it, so set <see cref="AriaLabel"/> when using it. Precedence: <see cref="ChildContent"/>, then <see cref="Figure"/> and <see cref="FigureUnit"/>, then the value and <see cref="Caption"/>.</summary>
    [Parameter]
    public string? FigureUnit { get; set; }

    /// <summary>Custom markup for the centre, in place of the text. For a text figure use <see cref="Figure"/> and <see cref="FigureUnit"/>; <see cref="Caption"/> still shows under it. Hidden from screen readers like the rest of the centre, so <see cref="AriaLabel"/> should describe what the centre shows; the default name goes by <see cref="Value"/> and can contradict it.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The accessible name of the ring. Defaults to the value, the maximum and the caption.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>Value of the data-testid attribute, and the prefix of <c>{TestId}-value</c> and <c>-caption</c>. None are rendered when unset.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>The value as shown: not finite or negative counts as zero, and fractions are rounded. State and text both go by it.</summary>
    private double Rounded => double.IsFinite(Value) ? Math.Round(Math.Max(Value, 0), MidpointRounding.AwayFromZero) : 0;

    private bool HasMax => double.IsFinite(Max) && Max > 0;

    private double RoundedMax => Math.Round(Max, MidpointRounding.AwayFromZero);

    private bool IsOver => HasMax && Rounded > RoundedMax;

    private string Shown => Number(Rounded);

    /// <summary>The centre number: <see cref="Figure"/> if not empty, else the value.</summary>
    private string Text => string.IsNullOrEmpty(Figure) ? Shown : Figure;

    /// <summary>The line under the centre number; <see cref="FigureUnit"/> only counts when there is no <see cref="ChildContent"/>.</summary>
    private string? Unit => ChildContent is null && !string.IsNullOrEmpty(FigureUnit) ? FigureUnit : Caption;

    /// <summary>Steps the number's size down as it gets wider: 6 characters ("12,345") is wider, 7 or more ("123,456") is widest; shorter numbers keep the base size.</summary>
    private string? Width => Text.Length switch { >= 7 => "widest", 6 => "wider", _ => null };

    /// <summary>Share of the ring that is filled, 0 to 1.</summary>
    private string Fill => (HasMax ? Math.Clamp(Rounded / Max, 0, 1) : Rounded > 0 ? 1 : 0)
        .ToString("0.####", CultureInfo.InvariantCulture);

    private string Description => AriaLabel ?? (HasMax ? $"{Shown} of {Number(RoundedMax)}" : Shown) + (Caption is null ? null : $" {Caption}");

    private string? Id(string part) => TestId is null ? null : $"{TestId}-{part}";

    private static string Number(double value) => value.ToString("N0", CultureInfo.InvariantCulture);
}
