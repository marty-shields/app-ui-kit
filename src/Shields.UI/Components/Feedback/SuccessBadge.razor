@using Shields.UI.Components.Actions
@using Shields.UI.Components.Layout
<span class="badge" data-testid="@TestId">
    <Icon Name="Icon" Tone="IconTone.Success" Size="IconSize.Small" />
    <Typography Variant="TextVariant.SuccessSmall">@Text</Typography>
</span>

@code {
    /// <summary>The words next to the icon, in bold success colour, such as "Record".</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    /// <summary>The icon before the text, in the success colour. The record mark by default.</summary>
    [Parameter]
    public IconName Icon { get; set; } = IconName.Record;

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
