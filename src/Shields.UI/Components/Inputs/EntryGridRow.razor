<div class="row @(Header ? "header" : null)" style="grid-template-columns: @Columns" aria-hidden="@(Header ? "true" : null)" data-testid="@TestId">
    <span class="index">@Index</span>
    @if (Aside is not null)
    {
        <span class="aside">@Aside</span>
    }
    @Fields
    @if (Actions is not null)
    {
        <span class="actions">@Actions</span>
    }
</div>

@code {
    /// <summary>The first, narrow column, such as the number of the entry. Centred and muted. Its width is <c>--entry-grid-index-width</c>.</summary>
    [Parameter]
    public RenderFragment? Index { get; set; }

    /// <summary>A narrow column after the index, before the fields, such as last time's value: muted, small, on one line. Its width is set by <see cref="AsideWidth"/>. Null leaves the column out.</summary>
    [Parameter]
    public RenderFragment? Aside { get; set; }

    /// <summary>
    /// The width of the <see cref="Aside"/> column: <see cref="EntryGridAsideWidth.Normal"/> (<c>--entry-grid-aside-width</c>, 3.5rem) by default,
    /// or <see cref="EntryGridAsideWidth.Wide"/> (<c>--entry-grid-aside-width-wide</c>) for a longer text such as 57.25kg×12. Give the header row and every data row the same value, so the columns line up.
    /// </summary>
    [Parameter]
    public EntryGridAsideWidth AsideWidth { get; set; }

    /// <summary>The fields, one grid cell each: write exactly <see cref="FieldCount"/> elements. Each cell takes an equal share of the room left.</summary>
    [Parameter]
    public RenderFragment? Fields { get; set; }

    /// <summary>The last column, one touch target wide, such as a remove button. Null leaves the column out.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>How many field cells <see cref="Fields"/> holds, so the columns line up from row to row.</summary>
    [Parameter, EditorRequired]
    public int FieldCount { get; set; }

    /// <summary>Makes this a header row of column titles: muted and small, aligned to the bottom of the cells, and hidden from screen readers, as the fields carry their own names.</summary>
    [Parameter]
    public bool Header { get; set; }

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private string Columns
    {
        get
        {
            var columns = new List<string> { "var(--entry-grid-index-width)" };
            if (Aside is not null)
            {
                columns.Add(AsideWidth == EntryGridAsideWidth.Wide ? "var(--entry-grid-aside-width-wide)" : "var(--entry-grid-aside-width)");
            }

            columns.AddRange(Enumerable.Repeat("minmax(0, 1fr)", Math.Max(FieldCount, 0)));
            if (Actions is not null)
            {
                columns.Add("var(--touch-target)");
            }

            return string.Join(' ', columns);
        }
    }
}
