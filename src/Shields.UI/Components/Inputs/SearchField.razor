@using Microsoft.AspNetCore.Components.Web
@using Shields.UI.Components.Actions
@using Shields.UI.Components.Layout

<div class="search input-box">
    <Icon Name="IconName.Search" Tone="IconTone.Muted" />
    <input type="search"
           class="input"
           value="@Value"
           placeholder="@Placeholder"
           aria-label="@AriaLabel"
           autocomplete="off"
           enterkeyhint="search"
           data-testid="@TestId"
           @oninput="OnInput"
           @onkeydown="OnKeyDown" />
    @if (Trailing is not null)
    {
        <span class="divider-slot"><Divider Vertical Decorative /></span>
        <span class="trailing">@Trailing</span>
    }
</div>

@code {
    /// <summary>The text.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Raised on every keystroke with the typed text.</summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Raised when Enter is pressed in the field, the search key of a phone's keyboard.</summary>
    [Parameter]
    public EventCallback OnEnter { get; set; }

    /// <summary>Hint shown while the field is empty.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Names the field for screen readers. The field has no visible label, so always set it.</summary>
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = "";

    /// <summary>Content at the end of the box after a vertical divider, such as an action <see cref="IconButton"/>. Null shows neither.</summary>
    [Parameter]
    public RenderFragment? Trailing { get; set; }

    /// <summary>Value of the data-testid attribute, on the input itself and not on the box.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? OnEnter.InvokeAsync() : Task.CompletedTask;
}
