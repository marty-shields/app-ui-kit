@* Named for what it holds, a value of a kind, not for the screen that first needed it. *@
@if (Kind == ValueKind.Duration)
{
    <DurationField @ref="duration"
                   Label="@Label"
                   ShowLabel="ShowLabel"
                   Required="Required"
                   Invalid="Invalid"
                   InvalidMessage="@InvalidMessage"
                   Disabled="Disabled"
                   Value="@Value"
                   ValueChanged="SetValue"
                   TestId="@TestId" />
}
else
{
    <NumberField @ref="number"
                 Label="@Label"
                 ShowLabel="ShowLabel"
                 Required="Required"
                 AllowDecimal="Kind == ValueKind.Fractional"
                 Unit="@Unit"
                 Invalid="Invalid"
                 InvalidMessage="@InvalidMessage"
                 Disabled="Disabled"
                 Compact="Compact"
                 Value="@(Value is null ? null : NumberField.Parse(Value))"
                 Text="@Value"
                 TextChanged="OnText"
                 OnEnter="OnEnter"
                 TestId="@TestId" />
}

@code {
    private DurationField? duration;
    private NumberField? number;

    /// <summary>Which control to show: a number box (whole or decimal) or the three boxes of a duration.</summary>
    [Parameter, EditorRequired]
    public ValueKind Kind { get; set; }

    /// <summary>What the value measures, with its unit, e.g. Weight (kg). Names the field for screen readers.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>Shows the label above the field. When false it is kept for screen readers only.</summary>
    [Parameter]
    public bool ShowLabel { get; set; } = true;

    /// <summary>Marks the field as required.</summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>Shows the field as failing validation, without a message.</summary>
    [Parameter]
    public bool Invalid { get; set; }

    /// <summary>Error shown under the field and announced. Null or empty means no message.</summary>
    [Parameter]
    public string? InvalidMessage { get; set; }

    /// <summary>Greys out the field.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Shown after the number. Ignored for a duration.</summary>
    [Parameter]
    public string? Unit { get; set; }

    /// <summary>Less padding either side of the number, so a long one fits a narrow cell. Ignored for a duration, whose boxes are always compact.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>The text exactly as typed, so what the user typed (such as <c>1.</c> or <c>abc</c>) is never replaced; the parent validates it. A duration is h:mm:ss. Null when empty.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Raised on every keystroke with the typed text, or null when empty. For a duration also raised to fill out a part-filled field when focus leaves it.</summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Raised when Enter is pressed in a number input. A duration ignores it.</summary>
    [Parameter]
    public EventCallback OnEnter { get; set; }

    /// <summary>Value of the data-testid attribute of the number input, or the prefix of a duration's boxes.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Moves focus to the number input, or the first box of a duration.</summary>
    public ValueTask FocusAsync() =>
        (Kind == ValueKind.Duration ? duration?.FocusAsync() : number?.FocusAsync()) ?? ValueTask.CompletedTask;

    private Task OnText(string text) => SetValue(string.IsNullOrEmpty(text) ? null : text);

    private Task SetValue(string? value) => ValueChanged.InvokeAsync(value);
}
