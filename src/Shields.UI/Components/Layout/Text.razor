@switch (As)
{
    case TextElement.P:
        <p @attributes="AdditionalAttributes" class="@CssClass" data-testid="@TestId">@ChildContent</p>
        break;
    case TextElement.Div:
        <div @attributes="AdditionalAttributes" class="@CssClass" data-testid="@TestId">@ChildContent</div>
        break;
    case TextElement.H2:
        <h2 @attributes="AdditionalAttributes" class="@CssClass" data-testid="@TestId">@ChildContent</h2>
        break;
    case TextElement.H3:
        <h3 @attributes="AdditionalAttributes" class="@CssClass" data-testid="@TestId">@ChildContent</h3>
        break;
    case TextElement.H4:
        <h4 @attributes="AdditionalAttributes" class="@CssClass" data-testid="@TestId">@ChildContent</h4>
        break;
    case TextElement.H5:
        <h5 @attributes="AdditionalAttributes" class="@CssClass" data-testid="@TestId">@ChildContent</h5>
        break;
    case TextElement.H6:
        <h6 @attributes="AdditionalAttributes" class="@CssClass" data-testid="@TestId">@ChildContent</h6>
        break;
    default:
        <span @attributes="AdditionalAttributes" class="@CssClass" data-testid="@TestId">@ChildContent</span>
        break;
}

@code {
    /// <summary>Which look the text has.</summary>
    [Parameter]
    public TextVariant Variant { get; set; }

    /// <summary>Element to render, so a label can be a heading of the right level.</summary>
    [Parameter]
    public TextElement As { get; set; }

    /// <summary>The text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Other attributes, written to the element. A <c>class</c> is added to the component's own; <c>data-testid</c> is set by <see cref="TestId"/>.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass
    {
        get
        {
            var own = Variant switch
            {
                TextVariant.Label => "text label",
                TextVariant.Muted => "text muted",
                TextVariant.MutedSmall => "text muted-small",
                TextVariant.Strong => "text strong",
                TextVariant.Figure => "text figure",
                TextVariant.Error => "text error",
                _ => "text",
            };
            return AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var extra) ? $"{own} {extra}" : own;
        }
    }
}
