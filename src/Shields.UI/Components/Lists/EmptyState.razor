<div class="empty" data-testid="@TestId">
    <p class="message" data-testid="@(TestId is null ? null : $"{TestId}-message")">@Message</p>
    @if (Hint is not null)
    {
        <p class="hint" data-testid="@(TestId is null ? null : $"{TestId}-hint")" data-wrap-ok>@Hint</p>
    }
    @ChildContent
</div>

@code {
    /// <summary>Text shown when there is nothing to list.</summary>
    [Parameter, EditorRequired]
    public string Message { get; set; } = "";

    /// <summary>What to do to fill the list, shown smaller under the message. Null shows no hint.</summary>
    [Parameter]
    public string? Hint { get; set; }

    /// <summary>Optional action under the message.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Value of the data-testid attribute; also the prefix for <c>{TestId}-message</c> and <c>{TestId}-hint</c>. None are rendered when unset.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
