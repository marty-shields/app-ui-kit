@if (OnClick.HasDelegate)
{
    <button @attributes="AdditionalAttributes" type="button" class="row clickable @Modifiers" data-testid="@TestId" @onclick="OnClick">
        @Body
        <span class="chevron"><Icon Name="IconName.Chevron" Tone="IconTone.Muted" /></span>
    </button>
}
else
{
    <div @attributes="AdditionalAttributes" class="row @Modifiers" data-testid="@TestId">
        @Body
    </div>
}

@code {
    /// <summary>Main line of the row. Wraps when too long for one line.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    /// <summary>Muted second line under the text.</summary>
    [Parameter]
    public string? Detail { get; set; }

    /// <summary>Muted text at the right, before the chevron.</summary>
    [Parameter]
    public string? Aside { get; set; }

    /// <summary>Raised when the row is tapped. The row is not tappable, and shows no chevron, when unset.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>How the text, detail and aside are arranged. <see cref="ListRowLayout.Stacked"/> by default.</summary>
    [Parameter]
    public ListRowLayout Layout { get; set; }

    /// <summary>Draws the line under the row. True by default; false for the last row of a card or a row that stands alone.</summary>
    [Parameter]
    public bool Divider { get; set; } = true;

    /// <summary>Content before the text in a narrow column the width of an entry-grid index, centred and muted: a number, or an icon such as the record mark.</summary>
    [Parameter]
    public RenderFragment? Leading { get; set; }

    /// <summary>How a value moved, after the aside: a coloured arrow with the amount, or a dash for no change, read out as "up", "down" or "no change". Null shows none.</summary>
    [Parameter]
    public StatChange? Change { get; set; }

    /// <summary>Content at the end of the row, after the change and before the chevron, such as action buttons. A tappable row is a button, so keep this non-interactive when <see cref="OnClick"/> is set.</summary>
    [Parameter]
    public RenderFragment? Trailing { get; set; }

    /// <summary>
    /// Makes <see cref="Text"/> a heading of this level, 2 to 6 (<c>role="heading"</c> with <c>aria-level</c>), so screen reader users can jump between rows that start a section. Null, the default, leaves it plain text.
    /// The look does not change. In a tappable row the heading is inside a button, where screen readers read the button's name instead, so use it on rows without <see cref="OnClick"/>.
    /// </summary>
    [Parameter]
    public int? HeadingLevel { get; set; }

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Other attributes for the row's root element (the button of a tappable row), such as <c>data-*</c> attributes. <c>type</c>, <c>class</c> and <c>data-testid</c> are the row's own and win.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnParametersSet()
    {
        if (HeadingLevel is < 2 or > 6)
        {
            throw new ArgumentOutOfRangeException(nameof(HeadingLevel), HeadingLevel, "HeadingLevel is 2 to 6, or null.");
        }
    }

    private string Modifiers => string.Join(' ', new[]
    {
        Detail is not null ? "two-line" : null,
        Layout == ListRowLayout.Headline ? "headline" : null,
        Divider ? null : "no-divider",
    }.Where(c => c is not null));

    private RenderFragment Body =>
        @<text>
            @if (Leading is not null)
            {
                <span class="leading">@Leading</span>
            }
            @Texts
            @if (Aside is not null)
            {
                <span class="aside">@Aside</span>
            }
            @if (Change is not null)
            {
                <ChangeIndicator Change="Change" />
            }
            @if (Trailing is not null)
            {
                <span class="trailing">@Trailing</span>
            }
        </text>;

    private RenderFragment Texts =>
        @<span class="texts">
            <span class="text" role="@(HeadingLevel is null ? null : "heading")" aria-level="@HeadingLevel" data-wrap-ok>@Text</span>
            @if (Detail is not null)
            {
                <span class="detail" data-wrap-ok>@Detail</span>
            }
        </span>;
}
