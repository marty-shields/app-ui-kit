@implements IDisposable
@using Shields.UI.Navigation
@inject IBackButton BackButton

@code {
    /// <summary>Raised by the Android back button. Not registered when unset.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private IDisposable? registration;
    private bool running;
    private bool disposed;

    protected override void OnInitialized() => BackButton.Attached += OnAttached;

    protected override void OnParametersSet()
    {
        if (OnBack.HasDelegate && registration is null)
        {
            registration = BackButton.Register(() => InvokeAsync(HandleAsync));
        }
        else if (!OnBack.HasDelegate && registration is not null)
        {
            registration.Dispose();
            registration = null;
        }
    }

    // Attach removed this handler's registration without telling it; register again with the new activity.
    private void OnAttached() => _ = InvokeAsync(() =>
    {
        if (!disposed)
        {
            registration = null;
            OnParametersSet();
        }
    });

    // Passes a failure to the nearest error boundary, as an exception from a button click would.
    private async Task HandleAsync()
    {
        // A press queued before the handler was removed must not run it, nor may a second press while the first runs.
        if (registration is null || running)
        {
            return;
        }

        running = true;
        try
        {
            await OnBack.InvokeAsync();
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
        finally
        {
            running = false;
        }
    }

    public void Dispose()
    {
        disposed = true;
        BackButton.Attached -= OnAttached;
        registration?.Dispose();
        registration = null;
    }
}
