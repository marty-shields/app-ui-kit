<div class="stepper" data-testid="@TestId">
    <button type="button"
            class="step"
            aria-label="@($"Previous {Unit}")"
            disabled="@(!CanGoPrevious)"
            data-testid="@Id("previous")"
            @onclick="OnPrevious">
        <Icon Name="IconName.ChevronLeft" />
    </button>
    <span class="label" aria-live="polite" data-wrap-ok data-testid="@Id("label")">@Label</span>
    <button type="button"
            class="step"
            aria-label="@($"Next {Unit}")"
            disabled="@(!CanGoNext)"
            data-testid="@Id("next")"
            @onclick="OnNext">
        <Icon Name="IconName.Chevron" />
    </button>
</div>

@code {
    /// <summary>Names the arrows: Previous week, Next month.</summary>
    [Parameter, EditorRequired]
    public PeriodKind Kind { get; set; }

    /// <summary>The period's name, e.g. 16 – 22 Nov, November 2026 or 2026. Read out when it changes. Wraps when too long for one line.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>False disables the previous arrow, e.g. at the first period with data.</summary>
    [Parameter]
    public bool CanGoPrevious { get; set; }

    /// <summary>False disables the next arrow, e.g. at the period that holds today.</summary>
    [Parameter]
    public bool CanGoNext { get; set; }

    /// <summary>Raised by the previous arrow.</summary>
    [Parameter]
    public EventCallback OnPrevious { get; set; }

    /// <summary>Raised by the next arrow.</summary>
    [Parameter]
    public EventCallback OnNext { get; set; }

    /// <summary>Value of the data-testid attribute, and the prefix of its parts': <c>{TestId}-previous</c>, <c>{TestId}-label</c>, <c>{TestId}-next</c>. None are rendered when unset.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private string Unit => Kind.ToString().ToLowerInvariant();

    private string? Id(string part) => TestId is null ? null : $"{TestId}-{part}";
}
